---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/hero/Hero.astro';
import Footer from '../components/footer/Footer.astro';
import PortfolioCTA from '../components/cta/PortfolioCTA.astro';
import ProjectSection from '../components/project/ProjectSection.astro';

import LoreContent, { frontmatter as loreFM } from '../content/lore-master-assistant.mdx';
import MandoContent, { frontmatter as mandoFM } from '../content/rule-the-mando.mdx';
import KintsugiContent, { frontmatter as kintsugiFM } from '../content/kintsugi-the-fall.mdx';
---

<BaseLayout>
  <main>
    <Hero />

    <ProjectSection
      slug={loreFM.slug}
      title={loreFM.title}
      tagline={loreFM.tagline}
      palette={loreFM.palette}
    >
      <LoreContent />
    </ProjectSection>

    <ProjectSection
      slug={mandoFM.slug}
      title={mandoFM.title}
      tagline={mandoFM.tagline}
      palette={mandoFM.palette}
    >
      <MandoContent />
    </ProjectSection>

    <ProjectSection
      slug={kintsugiFM.slug}
      title={kintsugiFM.title}
      tagline={kintsugiFM.tagline}
      palette={kintsugiFM.palette}
    >
      <KintsugiContent />
    </ProjectSection>

    <PortfolioCTA />
  </main>

  <Footer />
</BaseLayout>
