---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/hero/Hero.astro';
import Footer from '../components/footer/Footer.astro';
import PortfolioCTA from '../components/cta/PortfolioCTA.astro';
import ProjectSection from '../components/project/ProjectSection.astro';

import LoreContent, { frontmatter as loreFM } from '../content/lore-master-assistant.mdx';
import GonnaBeContent, { frontmatter as gonnaBeFM } from '../content/gonna-be.mdx';
import KintsugiContent, { frontmatter as kintsugiFM } from '../content/kintsugi-the-fall.mdx';
---

<BaseLayout>
  <main>
    <Hero />

    <ProjectSection
      slug={loreFM.slug}
      title={loreFM.title}
      tagline={loreFM.tagline}
      palette={loreFM.palette}
    >
      <LoreContent />
    </ProjectSection>

    <ProjectSection
      slug={gonnaBeFM.slug}
      title={gonnaBeFM.title}
      tagline={gonnaBeFM.tagline}
      palette={gonnaBeFM.palette}
    >
      <GonnaBeContent />
    </ProjectSection>

    <ProjectSection
      slug={kintsugiFM.slug}
      title={kintsugiFM.title}
      tagline={kintsugiFM.tagline}
      palette={kintsugiFM.palette}
    >
      <KintsugiContent />
    </ProjectSection>

    <PortfolioCTA />
  </main>

  <Footer />
</BaseLayout>
