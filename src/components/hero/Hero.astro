---
const headline = 'BUILT FROM CURIOSITY.';
---

<section class="hero" aria-labelledby="hero-headline" data-bg-section="hero">
  <h1 id="hero-headline" class="hero__headline" data-reveal="title">{headline}</h1>
  <p class="hero__scroll" aria-hidden="true">scroll</p>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    align-items: center;
    padding: var(--sp-8) var(--sp-4);
  }

  .hero__headline {
    font-size: var(--fs-display-xl);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .hero__scroll {
    justify-self: center;
    margin-top: var(--sp-8);
    font-size: 0.75rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  @media (max-width: 768px) {
    .hero {
      padding: var(--sp-6) var(--sp-3);
    }
  }
</style>
