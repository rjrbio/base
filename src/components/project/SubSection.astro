---
interface Props {
  id: string;
  label?: string;
}

const { id, label } = Astro.props;
---

<article class="subsection" data-pinning-id={id}>
  {label && <h3 class="subsection__label">{label}</h3>}
  <div class="subsection__content">
    <slot />
  </div>
</article>

<style>
  .subsection {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: var(--sp-4);
    max-width: 80ch;
  }

  .subsection::before {
    content: '';
    position: absolute;
    inset: calc(var(--sp-4) * -1);
    background: rgba(0, 0, 0, 0.5);
    mask-image: radial-gradient(
      ellipse 70% 55% at 50% 70%,
      black 0%,
      rgba(0, 0, 0, 0.85) 25%,
      transparent 80%
    );
    -webkit-mask-image: radial-gradient(
      ellipse 70% 55% at 50% 70%,
      black 0%,
      rgba(0, 0, 0, 0.85) 25%,
      transparent 80%
    );
    pointer-events: none;
    z-index: -1;
  }

  .subsection__label {
    margin: 0;
    color: var(--project-accent, var(--fg-muted));
    font-size: 0.875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.4em;
    text-shadow:
      0 0 32px rgba(0, 0, 0, 0.95),
      0 0 16px rgba(0, 0, 0, 0.9),
      0 0 6px rgba(0, 0, 0, 0.85),
      0 0 2px rgba(0, 0, 0, 0.8);
  }

  .subsection__content {
    display: grid;
    gap: var(--sp-3);
  }

  .subsection__content :global(p) {
    margin: 0;
    max-width: 65ch;
    color: var(--fg);
    font-size: var(--fs-body);
    line-height: 1.7;
    text-shadow:
      0 0 36px rgba(0, 0, 0, 0.95),
      0 0 18px rgba(0, 0, 0, 0.9),
      0 0 8px rgba(0, 0, 0, 0.85),
      0 0 2px rgba(0, 0, 0, 0.8);
  }

  @media (min-width: 900px) {
    .subsection {
      max-width: 110ch;
    }

    .subsection::before {
      mask-image: radial-gradient(
        ellipse 45% 75% at 78% 50%,
        black 0%,
        rgba(0, 0, 0, 0.85) 25%,
        transparent 80%
      );
      -webkit-mask-image: radial-gradient(
        ellipse 45% 75% at 78% 50%,
        black 0%,
        rgba(0, 0, 0, 0.85) 25%,
        transparent 80%
      );
    }

    .subsection__content {
      grid-template-columns: 3fr 2fr;
      align-items: center;
      gap: var(--sp-6);
    }

    .subsection__content :global(p) {
      max-width: 38ch;
    }
  }

  .subsection__content :global(.asset-placeholder) {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    width: 100%;
    padding: var(--sp-4);
    background: color-mix(in srgb, var(--fg) 4%, var(--bg));
    border: 1px dashed color-mix(in srgb, var(--fg) 14%, transparent);
    border-radius: 4px;
    color: var(--fg-muted);
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    text-align: center;
  }

  .subsection__content :global(.project-image) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
    border: 1px solid color-mix(in srgb, var(--project-accent) 50%, transparent);
    outline: 1px solid color-mix(in srgb, var(--project-accent) 22%, transparent);
    outline-offset: 6px;
    box-shadow:
      0 14px 40px rgba(0, 0, 0, 0.55),
      0 4px 12px rgba(0, 0, 0, 0.4);
    will-change: transform;
  }
</style>
