---
import fs from 'node:fs';
import path from 'node:path';
import '../styles/reset.css';
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/globals.css';
import AudioToggle from '../components/audio/AudioToggle.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Projects Showcase',
  description = 'Built from curiosity. Lore Master Assistant, GonnaBe, Kintsugi: The Fall.',
} = Astro.props;

const audioAvailable = fs.existsSync(path.join(process.cwd(), 'public/audio/ambient.mp3'));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/inter-400-latin.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/bricolage-grotesque-700-latin.woff2"
      crossorigin
    />
  </head>
  <body>
    <canvas class="background-canvas" data-background-canvas aria-hidden="true"></canvas>
    <slot />
    <AudioToggle audioAvailable={audioAvailable} />
    <script>
      import { initBackground } from '../lib/three/BackgroundManager';
      import { initScroll } from '../lib/scroll/ScrollOrchestrator';
      initBackground();
      initScroll();
    </script>
  </body>
</html>
